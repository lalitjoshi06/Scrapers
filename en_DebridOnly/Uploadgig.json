{
  "name": "Dailyup",
  "language": ["hi", "en"],
  "domains": ["rlsbb.ru", "rlsbb.to", "rlsbb.com", "rlsbb.unblocked.cx"],
  "base_url": "https://search.rlsbb.to",

  "search_url_format_episode": {
    "string_format": "/?s=%s+S%02dE%02d",
    "replacement": ["title", "season_int", "episode_int"]
  },
  "search_url_format_movie": {
    "string_format": "/?s=%s+%04d",
    "replacement": ["title", "year_int"]
  },

  "more_pages_indicator": "Next",
  "next_page_path": "a.next",
  "next_page_path_attr": "href",
  "links_on_first_page": false,
  "drill_down_path": "div#post-wrapper div.post-wrapper-hentry h1.entry-title a",
  "drill_down_path_attr": "href",
  "is_torrent": false,
  "is_direct": true,
  "links_container_path": "ul.commentList div.messageBox",
  "link_path": "a[href*='dailyuploads.net']",
  "link_path_attr": "href",
  "title_path": "p:not(:has(a)), div.messageBox strong, div.messageBox p",
  "title_path_attr": "",
  "details_path": "div.messageBox .date",
  "details_path_attr": "",
  "magnet_path": "",
  "magnet_path_attr": "",
  "seeders_path": "",
  "seeders_path_attr": "",
  "filesize_path": "p:contains(Size), p:contains(GB), p:contains(MB)",
  "filesize_path_attr": "",
  "filesize_units": "GB",
  "quality_path": "|title_path|",
  "quality_path_attr": "",
  "info_path": "|title_path|",
  "info_path_attr": ""
}
