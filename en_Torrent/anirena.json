{
  "name": "AniRena",
  "language": [
    "en"
  ],
  "domains": [
    "www.anirena.com",
    "anirena.com"
  ],
  "base_url": "https://www.anirena.com",
  "search_url_format_episode": {
    "string_format": "/?q=%s+s%02de%02d",
    "replacement": [
      "title_lower",
      "season_int",
      "episode_int"
    ]
  },
  "search_url_format_movie": {
    "string_format": "/?q=%s+%04d",
    "replacement": [
      "title_lower",
      "year_int"
    ]
  },
  "search_url_format_season_pack": {
    "string_format": "/?q=%s",
    "replacement": [
      "title_lower"
    ]
  },
  "check_title_before_drill_down": true,
  "drill_down_title_check_attr": "|HTML|",
  "max_more_pages": 10,
  "more_pages_indicator": "title=\"Next page\" class=tl-page-btn",
  "next_page_path": "a[title='Next page']",
  "next_page_path_attr": "abs:href",
  "links_on_first_page": false,
  "drill_down_path": "a.tl-torrent-name",
  "drill_down_path_attr": "abs:href",
  "is_torrent": true,
  "is_direct": false,
  "links_container_path": "div.td-ov-hashes",
  "link_path": "",
  "link_path_attr": "",
  "title_path": "/h1.td-title",
  "title_path_attr": "",
  "details_path": "|title_path|",
  "details_path_attr": "",
  "magnet_path": "code.td-ov-stat-hash",
  "magnet_path_attr": "|hash|",
  "seeders_path": "/div.td-ov-stat--se div.td-ov-stat-num",
  "seeders_path_attr": "",
  "filesize_path": "/div.td-ov-stat:has(div.td-ov-stat-lbl:contains(Size)) div.td-ov-stat-num",
  "filesize_path_attr": "",
  "quality_path": "|title_path|",
  "quality_path_attr": "",
  "info_path": "|title_path|",
  "info_path_attr": ""
}
